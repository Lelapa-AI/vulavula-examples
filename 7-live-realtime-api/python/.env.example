# Copy this file to `.env` and fill in your key. (Obtain one at https://vulavula.lelapa.ai/)
VULAVULA_API_KEY='<YOUR VALID API KEY>'
BASE_URL=https://api.lelapa.ai
# Folder with the sample WAVs + metadata index CSV. Defaults to the repo-root data/ folder
# (next to this example); set DATA_DIR only if your samples live elsewhere.
# DATA_DIR=../../data/
# Which sample to stream (0-4 -- see data/vulavula-isizulu-samples - 5_sample_metadata.csv).
SAMPLE_INDEX=0
# Translation target language, e.g. "eng" for isiZulu -> English. Leave blank for transcription-only.
TARGET_LANGUAGE=eng
# Print the CSV's ground-truth transcript/translation + a similarity score after streaming.
# Off by default: the score isn't an accuracy benchmark while the models are being tuned.
SHOW_GROUND_TRUTH=false
